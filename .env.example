# Murmur 的可选外部服务配置。默认不连接上游的托管账号、relay 或遥测服务。
# 填写自己的公开客户端配置；不要提交私密凭证。
# MURMUR_HOME=/absolute/path/to/.murmur
# MURMUR_CLERK_PUBLISHABLE_KEY=
# MURMUR_CLERK_JWT_TEMPLATE=
# MURMUR_CLERK_CLI_OAUTH_CLIENT_ID=
# MURMUR_RELAY_URL=https://relay.example.com
# MURMUR_HOSTED_APP_URL=https://app.example.com
# MURMUR_APPLE_TEAM_ID=
# MURMUR_MACOS_PROVISIONING_PROFILE=/absolute/path/to/murmur.provisionprofile
# MURMUR_CLERK_PASSKEY_RP_DOMAINS=
# MURMUR_MOBILE_OTLP_TRACES_URL=
# MURMUR_MOBILE_OTLP_TRACES_DATASET=
# MURMUR_MOBILE_OTLP_TRACES_TOKEN=
# 可选：自行配置 Expo 项目后，才开启移动端 OTA。
# MURMUR_EXPO_PROJECT_ID=
# MURMUR_EXPO_OWNER=
# MURMUR_MOBILE_UPDATES_ENABLED=0
# 移动端关联域名、Apple Team ID 与网站 .well-known 文件需使用自己的配置。
# MURMUR_PASSKEY_RP_DOMAIN=
